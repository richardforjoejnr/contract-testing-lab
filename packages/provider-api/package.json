{
  "name": "@lab/provider-api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "orders-api: NestJS HTTP provider, verified against the web-dashboard contract.",
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:pact": "vitest run test/pact",
    "test:brittle": "vitest run test/demos"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.1",
    "@pact-foundation/pact": "17.1.2",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  }
}
